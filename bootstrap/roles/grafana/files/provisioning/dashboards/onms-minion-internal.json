      "targets": [
        {
          "expr": "label_replace(label_replace({__name__=~\"org_opennms_core_ipc_rpc_(${location:pipe})_(collect|detect|dns|echo|poller|snmp)_requestsent_oneminuterate\"}, \"module\", \"$2\", \"__name__\", \"org_opennms_core_ipc_rpc_(.+)_(collect|detect|dns|echo|poller|snmp)_requestsent_oneminuterate\"), \"location\", \"$1\", \"__name__\", \"org_opennms_core_ipc_rpc_(.+)_(collect|detect|dns|echo|poller|snmp)_requestsent_oneminuterate\")",
          "legendFormat": "{{location}} · {{module}}",
