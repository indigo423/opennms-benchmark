{
  "title": "OpenNMS Minion Kafka IPC",
  "uid": "onms-minion-internal",
  "description": "Is the Kafka IPC path between the OpenNMS core and its Minions saturated? RPC health is measured at the core (the Minion-side mirror needs the JMX exporter on the Minion, which the lab does not install yet); the sink direction is measured at the core consumer; the last row shows Minion JVM health once the exporter reports.",
  "tags": [
    "opennms",
    "minion",
    "kafka",
    "entity-detail",
    "audience:engineer"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 38,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Core internals (Prometheus)",
      "icon": "dashboard",
      "url": "/d/42118f3c-3c63-451a-9692-c3dd43b854c0",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "asDropdown": false,
      "tags": []
    },
    {
      "type": "link",
      "title": "JVM details (Prometheus)",
      "icon": "dashboard",
      "url": "/d/37118f3c-3c63-451a-9692-c3dd43b854c0",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "asDropdown": false,
      "tags": []
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "location",
        "label": "Minion location",
        "description": "OpenNMS monitoring location, extracted from the core's RPC metric names (the JMX exporter flattens the location into the metric name). Multi-select to compare locations side by side.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "metrics(org_opennms_core_ipc_rpc_.+_requestsent_oneminuterate)",
        "regex": "/org_opennms_core_ipc_rpc_(.+)_(?:collect|detect|dns|echo|poller|snmp)_requestsent_oneminuterate/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0
      },
      {
        "name": "minion",
        "label": "Minion",
        "description": "Minion hosts known to Prometheus (the jmx scrape job, port stripped so the picker shows the hostname). Drives the JVM row and the exporter stat; RPC panels are per location, not per Minion, because the core only sees the location.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"jmx\", app=\"minion\"}, instance)",
        "regex": "/([^:]+):\\d+/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0
      },
      {
        "name": "filters",
        "label": "Filters",
        "description": "Ad-hoc label filters for pivots this dashboard did not anticipate.",
        "type": "adhoc",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is the Kafka IPC path to the Minions keeping up?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RPC requests failing",
      "description": "Share of RPC requests from the core to the selected location(s) that failed or timed out, over the last minute (Dropwizard 1-minute rates). Normal is 0%. Anything above 1% means Minions answer too slowly or not at all. That is the first and most reliable symptom of a saturated Kafka RPC path. Above 5%, polling and collection results for that location can no longer be trusted.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(sum({__name__=~\"org_opennms_core_ipc_rpc_(${location:pipe})_.+_requestfailed_oneminuterate\"}) / clamp_min(sum({__name__=~\"org_opennms_core_ipc_rpc_(${location:pipe})_.+_requestsent_oneminuterate\"}), 1e-9), 1)",
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "yellow"
              },
              {
                "value": 0.05,
                "color": "red"
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "max": 1,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Slowest RPC round trip (p99, worst module)",
      "description": "Worst 99th-percentile RPC round-trip time across all modules (collect, detect, dns, echo, poller, snmp) for the selected location(s), measured at the core: request published to Kafka until the response arrives. Normal is well under a second. A rising p99 with a flat request rate means the path is queueing, with saturation building before failures start. The default RPC time-to-live is 20 s; values approaching it will surface as failures.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"org_opennms_core_ipc_rpc_(${location:pipe})_.+_duration_99thpercentile\"})",
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1000,
                "color": "yellow"
              },
              {
                "value": 5000,
                "color": "red"
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "RPC request rate",
      "description": "RPC requests per second the core is sending to the selected location(s), all modules combined (1-minute rate). Context for the two panels to the left: a failure ratio only matters against real traffic. Compare against the benchmark's intended load to see whether the core is even offering the load you think it is.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum({__name__=~\"org_opennms_core_ipc_rpc_(${location:pipe})_.+_requestsent_oneminuterate\"})",
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Minion JMX exporter",
      "description": "Whether Prometheus can scrape the Minion's JMX exporter on port 9299. The lab already scrapes minion:9299, but the opennms_minion role does not yet install the jmx_prometheus_javaagent (only opennms_core does), so this reads 'not reporting' until that gap is closed. While it is down, the whole 'Minion JVM' row below has no data and RPC health is visible only from the core side.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"jmx\", app=\"minion\", instance=~\"(${minion:pipe}):.*\"})",
          "instant": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "reporting",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "not reporting",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "no target",
                  "color": "text",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "no target"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
