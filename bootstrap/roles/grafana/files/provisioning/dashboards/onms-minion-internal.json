    {
      "id": 13,
      "type": "timeseries",
      "title": "Sink consumer queue depth by module",
      "description": "Messages waiting in the core's off-heap dispatch queue after being consumed from Kafka, per sink module. This is the core-side saturation gauge for the Minion-to-core direction: a sustained non-zero depth means the core consumes faster from Kafka than its handlers can process. The next stage is drops. Spikes that drain within a scrape or two are normal burst absorption.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "label_replace({__name__=~\"org_opennms_core_ipc_sink_consumer_.+_queue_size_value\"}, \"module\", \"$1\", \"__name__\", \"org_opennms_core_ipc_sink_consumer_(.+)_queue_size_value\")",
          "legendFormat": "{{module}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
