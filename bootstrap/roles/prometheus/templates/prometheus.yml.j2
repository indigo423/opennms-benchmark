---
# my global config
global:
  scrape_interval: 15s # Set the scrape interval to every 15 seconds. Default is every 1 minute.
  evaluation_interval: 15s # Evaluate rules every 15 seconds. The default is every 1 minute.
  # scrape_timeout is set to the global default (10s).

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
# - alertmanager:9093

# Load rules once and periodically evaluate them according to the global 'evaluation_interval'.
rule_files:
# - "first_rules.yml"
# - "second_rules.yml"

# A scrape configuration containing exactly one endpoint to scrape:
# Here it's Prometheus itself.
scrape_configs:
  # The job name is added as a label `job=<job_name>` to any timeseries scraped from this config.
  - job_name: "prometheus"

    # metrics_path defaults to '/metrics'
    # scheme defaults to 'http'.

    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "node"
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ host }}:9100"
{% endfor %}

  - job_name: "jmx"
    tls_config:
      insecure_skip_verify: true
    static_configs:
{% for host in groups['core'] | default([]) %}
      - targets: ["{{ host }}:9299"]
        labels:
          app: "core"
{% endfor %}
{% for host in groups['minion'] | default([]) %}
      - targets: ["{{ host }}:9299"]
        labels:
          app: "minion"
{% endfor %}
{% for host in groups['sentinel'] | default([]) %}
      - targets: ["{{ host }}:9299"]
        labels:
          app: "sentinel"
{% endfor %}

  - job_name: "pyroscope"
    static_configs:
{% for host in groups['mon_servers'] | default([]) %}
      - targets: ["{{ host }}:{{ lab_pyroscope_port }}"]
        labels:
          app: "pyroscope"
{% endfor %}

{# VictoriaMetrics exports its own instrumentation on the same port it serves    #}
{# on, so scraping it needs no exporter. Two ways it can appear:                 #}
{#                                                                              #}
{#   in-lab   a victoriametrics group member, as vm-single provisions            #}
{#   off-lab  the remote_write backend a deployment writes to, which vm-target    #}
{#            provisions on a different lab entirely                             #}
{#                                                                              #}
{# The off-lab target is derived from opennms_remotewrite.write_url rather than   #}
{# written here. That URL is set by the deployment or experiment overlay and is   #}
{# the address's one definition; a second copy in this template would disagree    #}
{# with it the first time the backend moves.                                     #}
{#                                                                              #}
{# A third way, the escape hatch: prometheus_victoriametrics_targets. A store on  #}
{# another lab that nothing here writes to yet has no other route into this      #}
{# config, because the two derivations above both go through this deployment.    #}
{# Prefer either of them; reach for this only when neither applies, and expect    #}
{# to remove it once remote_write is enabled and the address derives itself.     #}
{#                                                                              #}
{# Deduplicated because a deployment can be more than one of these: vm-single     #}
{# puts the store in the lab AND points write_url at it, and Prometheus rejects   #}
{# a config carrying the same target twice in one job.                           #}
{% set vm_targets = [] %}
{% for target in prometheus_victoriametrics_targets | default([]) %}
{%   set _ = vm_targets.append(target) %}
{% endfor %}
{% for host in groups['victoriametrics'] | default([]) %}
{%   if (host ~ ':8428') not in vm_targets %}
{%     set _ = vm_targets.append(host ~ ':8428') %}
{%   endif %}
{% endfor %}
{% if opennms_remotewrite is defined and opennms_remotewrite.enabled | default(false) %}
{%   set rw_authority = opennms_remotewrite.write_url | regex_replace('^https?://([^/]+).*$', '\\1') %}
{%   if rw_authority not in vm_targets %}
{%     set _ = vm_targets.append(rw_authority) %}
{%   endif %}
{% endif %}
{% if vm_targets %}
  # Accepted-throughput measurement point for a remote_write deployment (#316).
  # vm_rows_inserted_total{type="promremotewrite"} is what the backend actually
  # wrote, measured outside the plugin under test, which is why a write
  # comparison reads it rather than the plugin's own samplesWritten.
  - job_name: "victoriametrics"
    static_configs:
      - targets:
{% for target in vm_targets %}
          - "{{ target }}"
{% endfor %}
        labels:
          app: "victoriametrics"
{% endif %}
