# DO NOT EDIT THIS FILE
# Managed by Ansible: deployments/roles/opennms_pyroscope_agent (#291)
#
# Attaches the Pyroscope Java agent to {{ pyroscope_agent_unit }} without
# touching any file the indigo423.opennms collection renders. JAVA_TOOL_OPTIONS
# is read by every JVM the unit starts, so no start script needs to know.
#
# This drop-in owns JAVA_TOOL_OPTIONS exclusively. systemd Environment= assigns,
# it does not append, and it performs no variable expansion, so a second drop-in
# setting the same key would silently replace this one (last one lexically
# wins) and the agent would be gone with nothing failing.
[Service]
Environment=JAVA_TOOL_OPTIONS=-javaagent:{{ pyroscope_agent_jar }}
Environment=PYROSCOPE_SERVER_ADDRESS={{ pyroscope_agent_server_address }}
Environment=PYROSCOPE_APPLICATION_NAME={{ pyroscope_agent_app_name }}
Environment=PYROSCOPE_LABELS=hostname={{ inventory_hostname }}
Environment=PYROSCOPE_PROFILER_EVENT={{ pyroscope_agent_event }}
Environment=PYROSCOPE_PROFILER_ALLOC={{ pyroscope_agent_alloc }}
Environment=PYROSCOPE_PROFILER_LOCK={{ pyroscope_agent_lock }}
Environment=PYROSCOPE_LOG_LEVEL={{ pyroscope_agent_log_level }}
