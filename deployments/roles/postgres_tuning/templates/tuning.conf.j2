#########
# DO NOT EDIT THIS FILE
# Managed by Ansible — deployments/roles/postgres_tuning
#
# Loaded via include_dir = 'conf.d' in postgresql.conf, so every setting here
# overrides the packaged default without editing the packaged file. Values are
# derived from this host's RAM and vCPU count, following pgtune's "Web
# application" profile: https://pgtune.leopard.in.ua/
#
# Rendered for {{ ansible_memtotal_mb }} MB RAM and {{ ansible_processor_vcpus }} vCPU.
######

# Connections ---------------------------------------------------------------
# Must exceed the sum of every client pool. OpenNMS opens the main pool plus two
# smaller ones from opennms-datasources.xml; the main pool's ceiling is set by
# OPENNMS_DATABASE_CONNECTION_MAXSIZE. A pool larger than this value fails at
# connect time, which surfaces as OpenNMS daemons blocking rather than as a
# database error.
max_connections = {{ postgres_tuning_max_connections }}

# Memory --------------------------------------------------------------------
shared_buffers = {{ postgres_tuning_shared_buffers_mb }}MB
effective_cache_size = {{ postgres_tuning_effective_cache_size_mb }}MB
maintenance_work_mem = {{ postgres_tuning_maintenance_work_mem_mb }}MB

# Per sort or hash node, NOT per connection: a single query with several such
# nodes can allocate this repeatedly, so the worst case is roughly
# work_mem x nodes x max_connections. Sized down accordingly.
work_mem = {{ postgres_tuning_work_mem_kb }}kB

# Planner -------------------------------------------------------------------
random_page_cost = {{ postgres_tuning_random_page_cost }}
effective_io_concurrency = {{ postgres_tuning_effective_io_concurrency }}
default_statistics_target = {{ postgres_tuning_default_statistics_target }}

# Parallelism ---------------------------------------------------------------
max_worker_processes = {{ postgres_tuning_max_worker_processes }}
max_parallel_workers = {{ postgres_tuning_max_parallel_workers }}
max_parallel_workers_per_gather = {{ postgres_tuning_max_parallel_workers_per_gather }}
max_parallel_maintenance_workers = {{ postgres_tuning_max_parallel_maintenance_workers }}

# Write-ahead log -----------------------------------------------------------
wal_buffers = {{ postgres_tuning_wal_buffers_mb }}MB
min_wal_size = {{ postgres_tuning_min_wal_size_gb }}GB
max_wal_size = {{ postgres_tuning_max_wal_size_gb }}GB
checkpoint_completion_target = {{ postgres_tuning_checkpoint_completion_target }}

# Deliberately NOT set: full_page_writes = off.
# It is safe on ZFS, whose copy-on-write layout cannot produce a torn page, and
# it measurably cuts WAL volume for an insert-heavy workload like this one. It
# is left on because this role does not verify the filesystem, and the setting
# becomes a data-corruption risk the moment the deployment lands on storage
# that is not copy-on-write. Enable it per-host only with the filesystem known.
