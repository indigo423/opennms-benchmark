---
{# Rendered by endpoints-playbook.yml. Keys are emitted only when the thing     #}
{# that provides them exists, so a deployment publishes what it runs and omits  #}
{# the rest rather than defaulting it.                                          #}
{#                                                                              #}
{# Addresses and ports come from the collapsed variables wherever one exists:   #}
{# kafka_bootstrap_servers and opennms_datasource_db_host already encode the    #}
{# group guard, the fallback chain and the port. Re-deriving them here would    #}
{# make this file a further copy of a value it exists to publish, which is the  #}
{# drift the whole change is meant to remove.                                   #}
{#                                                                              #}
{# Anything per-host goes through hostvars, never bare. A bare name resolves    #}
{# against the localhost play's own scope, where role defaults and net_sim      #}
{# group vars are invisible, so it would silently render this template's        #}
{# fallback instead of the lab's value — the same trap as #197.                 #}
# DO NOT EDIT — generated by endpoints-playbook.yml (make endpoints).
#
# What an experiment must target on this deployment. Regenerate at any time with
#   make endpoints PROVIDER=<p> DEPLOYMENT=<slug>
# Generation is read-only: it reads the inventory and contacts no lab host.
schema_version: 1
generated: "{{ '%Y-%m-%dT%H:%M:%SZ' | strftime(endpoints_now, utc=true) }}"
deployment: "{{ lab_deployment | default('unknown', true) }}"
descriptor: "{{ endpoints_descriptor.stdout | default('unknown', true) | trim }}"
provider: "{{ lab_provider | default('unknown', true) }}"

{% set minion = groups['minion'][0] if groups.get('minion') else none %}
{% set netsim = groups['net_sim'][0] if groups.get('net_sim') else none %}
{% set db = groups['database'][0] if groups.get('database') else none %}
{% set core = groups['core'][0] if groups.get('core') else none %}
{% set bootstrap = kafka_bootstrap_servers | default('', true) %}
{#- lab_mgmt_ip is emitted only by the spec-driven providers' inventory module,
    so it needs its own fallback or this fails on azure, vmware and proxmox. -#}
{% macro addr(host, subnet) -%}
{{ hostvars[host]['lab_' ~ subnet ~ '_ip']
   | default(hostvars[host].lab_mgmt_ip | default(hostvars[host].ansible_host, true), true) }}
{%- endmacro %}
{% if minion %}
# Where telemetry is accepted. Everything here arrives via the Minion, so the
# address is its sim-network address and the ports are the ones the pinned
# collection opens.
ingestion:
  syslog:
    host: "{{ addr(minion, 'sim') }}"
    port: {{ lab_syslog_port }}
    via: minion
    location: "{{ opennms_minion_controller.location | default('') }}"
  traps:
    host: "{{ addr(minion, 'sim') }}"
    port: {{ lab_trap_port }}
    via: minion
    location: "{{ opennms_minion_controller.location | default('') }}"
{% endif %}
{% if bootstrap or db or core %}

# Where results are read. With Kafka-exclusive forwarding the metrics topic is
# the only measurement point the deployment has.
measurement:
{% if bootstrap %}
  kafka:
    bootstrap: "{{ bootstrap }}"
    topics:
{% for name, topic in lab_kafka_topics.items() %}
      {{ name }}: "{{ topic }}"
{% endfor %}
{# Only claimed when the producer is actually configured. A broker used purely #}
{# for Minion IPC writes no metrics, and asserting a format for a topic nobody #}
{# produces to would be a confident lie.                                       #}
{% if endpoints_producer_enabled %}
    metric_format: CollectionSetProtos
{% endif %}
{% endif %}
{% if db %}
  database:
    host: "{{ opennms_datasource_db_host }}"
    port: {{ opennms_datasource_db_port | default(5432) }}
    name: "{{ opennms_datasource_db_name | default('opennms') }}"
{% endif %}
{% if core %}
  opennms:
    host: "{{ addr(core, 'mgmt') }}"
    port: 8980
{% endif %}
{% endif %}
{% if netsim %}

# The generator. sim_network is the contract: device addresses an experiment
# creates must fall inside it, or the Minion has no route and the forwarding
# rule does not match, and telemetry is discarded without a trace.
generators:
  nl6:
    url: "http://{{ addr(netsim, 'mgmt') }}:{{ hostvars[netsim].nl6_web_port | default(8080) }}"
    sim_network: "{{ hostvars[netsim].nl6_sim_network | default('10.42.0.0/16') }}"
    image: "{{ hostvars[netsim].nl6_image | default('unknown', true) }}"
{% endif %}
