# KVM-specific variables
libvirt_uri        = "qemu+ssh://root@your-kvm.host/system" # Remote: "qemu+ssh://user@host/system"
# Resource name prefix is "<environment>-<project_name>", the same scheme
# terraform/aws uses. These must differ or every name stutters. environment says
# what the lab is for: "dev" verifies the deployment works, "benchmark" is a run
# whose numbers are meant to be trusted. Guest hostnames are unaffected — they
# stay <role>-benchmark-NN on every provider.
project_name       = "benchmark"
environment        = "dev"
storage_pool       = "default"
# ubuntu_cloud_image is deliberately NOT set here. The pin lives in tracked
# Terraform (terraform/kvm/variables.tf), so a substrate bump arrives with a
# `git pull` and is reviewed as a diff, like the aws and azure pins.
#
# Setting it in this file is what produced #304: an example carrying a value is
# copied once and frozen, so the alias that was current in March survived every
# later correction to the example. Leave it unset unless you are overriding.
#
# To override, typically to serve the image from local storage: point it at a
# file reachable from the machine running Terraform, NOT from the KVM host.
# Both the validation and the provider's upload resolve client-side. A local
# file is identified by its contents, so replacing it changes the volume name.
# A floating alias such as noble/current/ is rejected: its contents change
# while its name does not, which is exactly what cannot be pinned.
ssh_key_path       = "~/.ssh/id_rsa"
admin_user         = "ubuntu" # Ubuntu cloud image default user
bridge_name        = "br0"    # Host bridge for external DHCP access on monintoring VM
# Only needed by deployments whose specs use the 'lab' subnet (statically
# addressed NICs on the physical bridge above).
# subnet_lab      = "192.168.0.0/24"          # CIDR of the LAN behind bridge_name; .1 is used as the gateway
# lab_nameservers = ["192.168.0.53"]          # Resolvers for lab NICs; omit to use the gateway
# jump_host        = ""      # Auto-discovered by deploy.sh from virsh domifaddr after VM boot
# Set manually only if auto-discovery fails: jump_host = "10.0.0.42"
