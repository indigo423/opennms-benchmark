# Proxmox-specific variables
# Usage:
#   cp proxmox.tfvars.example proxmox.tfvars
#   # Edit proxmox.tfvars with your real values (it is gitignored)
#   terraform init
#   terraform apply -var-file=../lab.tfvars -var-file=../disk-sizes.tfvars -var-file=proxmox.tfvars

# Proxmox API connection
proxmox_endpoint     = "https://192.168.1.10:8006/" # Replace with your Proxmox host IP/FQDN
# Prefer NOT setting this. The provider reads PROXMOX_VE_API_TOKEN from the
# environment, which keeps the secret off disk:
#   export PROXMOX_VE_API_TOKEN='user@realm!token-name=UUID'
# proxmox_api_token  = "user@realm!token-name=00000000-0000-0000-0000-000000000000"
proxmox_insecure     = false # Set true only if Proxmox has a self-signed certificate
proxmox_ssh_username = "root"

# Proxmox node name (visible in the Proxmox UI datacenter tree)
proxmox_node = "pve"

# Template VM — create once on the Proxmox host before running terraform apply.
# Full steps, including why the machine type matters, are in the README.
#
#   IMG=ubuntu-24.04-server-cloudimg-amd64.img
#   curl -fsSLO https://cloud-images.ubuntu.com/releases/noble/release-20260814/$IMG
#   qm create 9000 --name ubuntu-24.04-cloud --memory 2048 --cores 2 \
#     --net0 virtio,bridge=vmbr0 --scsihw virtio-scsi-pci
#   qm set 9000 --scsi0 local-lvm:0,import-from=$PWD/$IMG
#   qm set 9000 --ide2 local-lvm:cloudinit
#   qm set 9000 --serial0 socket --vga serial0
#   qm set 9000 --boot order=scsi0 --agent enabled=1
#   qm template 9000
#
# Do NOT pass --machine q35: guest NIC names depend on the machine type. The PVE
# default (i440fx) gives ens18/ens19/ens20, which is what modules/compute
# expects; q35 gives enp6s18 and every VM comes up with no network at all.
# Use a dated release path, not noble/current, which upstream republishes on
# every point release. The filename differs between the two paths.
template_vm_id = 9000

# Storage
storage_pool       = "local-lvm" # LVM-thin datastore for VM disks
snippets_datastore = "local"     # File-based datastore for cloud-init snippets (not LVM-thin)

# SSH key for VM access
ssh_key_path = "~/.ssh/id_rsa"

# Proxmox bridges. `make prepare-hypervisor HYPERVISOR=<host>` creates the lab
# bridges, makes the host route/NAT/resolve for the management subnet, and is
# idempotent.
#
# The mapping is shifted one place from the obvious reading: the bridge carrying
# the hypervisor's OWN address is bridge_ext, not bridge_mgmt. Claiming it for a
# lab subnet cuts off the host. The prep role asserts against exactly that.
#
# Only the monitoring VM attaches to bridge_ext; its DHCP lease is the lab's
# jump host, and every other VM is reached by proxying through it.
bridge_ext   = "vmbr0" # site LAN, DHCP — the hypervisor's existing uplink bridge
bridge_mgmt  = "vmbr1" # 192.0.2.192/26 — host holds .193 and routes/NATs/resolves
bridge_db    = "vmbr2" # 192.0.2.0/26   — no uplink
bridge_kafka = "vmbr3" # 192.0.2.64/26  — no uplink
bridge_sim   = "vmbr4" # 192.0.2.128/26 — no uplink

# VM IDs — must be unique across your Proxmox cluster.
# Defaults match the last octet of each VM's management IP.
# vm_ids = {
#   database      = 196
#   core          = 197
#   kafka         = 198
#   minion        = 199
#   monitoring    = 200
#   netsim        = 201
#   elasticsearch = 202
# }
# VM names in Proxmox UI follow [function]-[env]-[seq] convention:
#   db-benchmark-01, core-benchmark-01, kafka-benchmark-01,
#   minion-benchmark-01, netsim-benchmark-01, mon-benchmark-01

# Disk sizes — IMPORTANT: if overriding, provide ALL seven keys. Terraform replaces the entire
# map; a partial override (e.g. only "core") drops the remaining keys and causes a plan error.
# disk_sizes_gb = {
#   database      = 50
#   core          = 100
#   kafka         = 50
#   minion        = 20
#   netsim        = 20
#   monitoring    = 30
#   elasticsearch = 50
# }

# jump_host = ""  # Set after first apply: external IP of the monitoring VM (from bridge_ext DHCP).
#                 # Re-run apply to regenerate the Ansible inventory with ProxyJump enabled.
