# === macOS specific ===

# Finder metadata
.DS_Store

# macOS folder attributes
.AppleDouble
.LSOverride

# Thumbnails
._*

# Icon files
.Spotlight-V100
.Trashes
.VolumeIcon.icns

# === IntelliJ IDEA specific ===

# IntelliJ project files and folders
.idea/
*.iml
*.iws
out/

# OS generated files (for all systems)
*.log

# === Terraform specific ===

# Terraform local state files
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Exclude Terraform's .terraform directory which contains providers and modules downloaded by Terraform
**/.terraform/
.terraform.lock.hcl
**/.terraform.lock.hcl

# Sensitive variable files (uncomment if you don't want to commit your terraform variables)
# *.tfvars
# *.tfvars.json

# KVM tfvars contains a host-specific URI — gitignored, use kvm.tfvars.example as template
terraform/kvm/kvm.tfvars

# AWS tfvars carries a region/AZ and key path — gitignored, use aws.tfvars.example as template
terraform/aws/aws.tfvars

# Proxmox tfvars contains an API token — gitignored, use proxmox.tfvars.example as template
terraform/proxmox/proxmox.tfvars

# VMware tfvars contains a vCenter password — gitignored, use vmware.tfvars.example as template
terraform/vmware/vmware.tfvars

# CLI config files
.terraformrc
terraform.rc

# Override tfvars files with local settings (optional)
*.auto.tfvars

# === Claude Code / BMAD ===
.agent/
.agents/
.claude/
_bmad/
_bmad-output/
openspec/

# === Ansible specific ===

# Collections ansible-lint vendors into the tree when they are not already
# installed. Third-party, pinned in requirements.yml, and thousands of files —
# never ours to commit. Also excluded in .ansible-lint (#241).
.ansible/

# Generated by the inventory modules, one per provider (#277) — contains
# env-specific IPs and key paths. The unsuffixed name is the pre-#277 file.
ansible-inventory.yml
ansible-inventory.*.yml
# Generated by endpoints-playbook.yml alongside the inventory: terraform writes
# what machines exist, ansible writes what listens where. Same lifecycle, so
# same treatment.
lab-endpoints.yml
lab-endpoints.json
lab-endpoints.*.yml
lab-endpoints.*.json

# Repo-local Ansible Vault master key — minted by init_secrets, NEVER commit
vault_pass.secret

# === Python / lint tooling ===

__pycache__/
*.py[cod]
.ruff_cache/


# Every rule below is stated for both campaigns/ and experiments/. Measured
# records live in campaigns/; a playbook experiment that seals a capture in
# place still writes the same payloads under experiments/. Both prefixes are
# kept deliberately: a record relocated while only one prefix was listed turns
# tens of GB of pcap, perf, JFR and Prometheus series untracked and stageable
# in one step, and `git add .` then commits the artifact this repository keeps
# on disk on purpose.

# benchmark-report bundles
campaigns/*/results/bundle/
campaigns/*/results/*-report.tar.gz
experiments/*/results/bundle/
experiments/*/results/*-report.tar.gz

# Run logs that ARE the result, against the blanket *.log above. A campaign's
# log is the timestamped record of how its .jsonl came to exist, and without it
# the numbers have no provenance. `git add <dir>` honours .gitignore silently,
# so without this negation the data lands in a commit and the log that explains
# it does not, with nothing said either way.
!campaigns/*/results/*.log
!experiments/*/results/*.log

# benchmark-capture payloads. The artifact is tens of GB of pcap, perf, JFR,
# procfs tarballs and Prometheus series; only the manifest, the config, the
# checksums and the orchestrator log are small enough and useful enough to
# track. Everything else is reproducible only by re-running the capture, and
# is kept on disk rather than in git.
campaigns/*/results/hosts/
campaigns/*/results/prometheus/series/
campaigns/*/results/kafka/
experiments/*/results/hosts/
experiments/*/results/prometheus/series/
experiments/*/results/kafka/
# A superseded capture attempt kept on disk as a fallback; the sealed one is results/.
campaigns/*/results-attempt*/
experiments/*/results-attempt*/

# Scratch scripts pool_sweep.py writes before scp-ing them to the host, regenerated every run
campaigns/*/results/.prep.py
campaigns/*/results/.set_threads.py
experiments/*/results/.prep.py
experiments/*/results/.set_threads.py
