        "title": "Database connection pool on Core during collection",
        "unit": "connections",
        "kind": "line",
        "source": {
          "dashboard": "Prometheus: OpenNMS Core Internals",
          "panel": "HikariCP pool"
        },
        "note": "Read from the client side, since no PostgreSQL exporter runs in this lab. Metrics never touch PostgreSQL under exclusive Kafka forwarding; what the pool carries is Collectd scheduling state, the self-monitoring JDBC collections and provisiond.",
        "series": [
          {
            "label": "active connections",
            "expr": "com_zaxxer_hikari_pool_opennms_activeconnections{instance=\"core-benchmark-01:9299\"}",
            "decimals": 0
          },
          {
            "label": "idle connections",
            "expr": "com_zaxxer_hikari_pool_opennms_idleconnections{instance=\"core-benchmark-01:9299\"}",
            "decimals": 0
          },
          {
            "label": "threads awaiting a connection",
            "expr": "com_zaxxer_hikari_pool_opennms_threadsawaitingconnection{instance=\"core-benchmark-01:9299\"}",
            "decimals": 0
          },
          {
            "label": "pool maximum",
            "expr": "com_zaxxer_hikari_poolconfig_opennms_maximumpoolsize{instance=\"core-benchmark-01:9299\"}",
            "decimals": 0
          }
        ]
      },
      {
        "id": "db-io",
        "title": "Database VM disk I/O",
        "unit": "MB/s",
        "kind": "line",
        "source": {
          "dashboard": "Node Exporter Full",
          "panel": "Disk IOps"
        },
        "series": [
          {
            "label": "read",
            "expr": "rate(node_disk_read_bytes_total{instance=\"db-benchmark-01:9100\",device=\"sda\"}[5m]) / 1e6",
            "decimals": 2
          },
          {
            "label": "write",
            "expr": "rate(node_disk_written_bytes_total{instance=\"db-benchmark-01:9100\",device=\"sda\"}[5m]) / 1e6",
            "decimals": 2
          }
        ]
      }
    ]
