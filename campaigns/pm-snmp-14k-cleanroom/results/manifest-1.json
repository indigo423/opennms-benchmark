{
  "experiment": {
    "question": "What does a 14,000-device cleanroom deployment look like at steady state, and how much room is left in it?",
    "independent_variable": "workload.parameters.devices",
    "variant": "14000-devices-cleanroom-steady-state-7h",
    "plan": "Describe the deployment as it ran over a seven hour window, 00:00 to 07:00 local time (UTC+2), 22:00Z to 05:00Z, with the fleet held at 14,000 devices, no injected latency and no restart. Provisiond's rolling rescans run for the first hour of the window and are idle after, which is representative of normal operation rather than a lull. Every rate is a window integral over an integer number of 300 s cycles. Configuration is read from the running hosts, and the per-device sample composition from decoded Kafka records."
  },
  "sut": {
    "version_identity": {
      "version": "36.0.3",
      "package_version": "PoweredBy 2026 (same codebase as OpenNMS Horizon 36.0.3)"
    },
    "jvm": {
      "version": "21.0.12+8-1-24.04-Ubuntu (OpenJDK)",
      "heap": "-Xms8192m -Xmx10240m",
      "gc": "G1GC",
      "flags": "JAVA_HEAP_SIZE=10240 and JAVA_INITIAL_HEAP_SIZE=8192 in opennms.conf; ADDITIONAL_MANAGER_OPTIONS carries -XX:+UseG1GC and the Prometheus JMX exporter on 9299. No -Xlog GC logging is configured."
    },
    "db_version": "PostgreSQL 18.6 (Ubuntu 18.6-1.pgdg24.04+2)",
    "tss_backend": "kafka-exclusive",
    "config_delta": "",
    "provisioner": "ssh-package"
  },
  "host": {
    "cpu": "2 x Intel Xeon E5-2650 v4 @ 2.20 GHz, 24 physical cores / 48 threads; 28 vCPU running across 6 VMs",
    "ram_gb": 252,
    "disk": "ZFS pool scummbar, 808 GiB, 579 used; local-lvm 171 GiB and local 94 GiB unused by the lab",
    "os": "Proxmox VE 9.2.2, kernel 7.0.2-6-pve; guests Ubuntu 24.04.4 LTS cloud image",
    "generator_colocated": true,
    "hygiene_notes": "Dell PowerEdge R630, node lechuck. Every VM: q35, cpu=host, numa=1. 28 running vCPU against 24 physical cores, mildly oversubscribed at peak; 60 GiB of 252 assigned to VMs. Read live from the Proxmox API."
  },
  "workload": {
    "axis": "snmp-collection",
    "generator_scenario": "nl6 v0.28.0, cisco_crs_x.json profile, 14,000 simulated Cisco CRS-X core routers with 144 interfaces each, SNMP v2c community public, 10.42.0.0/16 one /24 per 250 devices across third octets 0-55",
    "generator_version": "ghcr.io/labmonkeys-space/nl6:v0.28.0",
    "parameters": {
      "devices": 14000,
      "nodes_in_inventory": 14002,
      "collectable_services": 14004,
      "snmp_interfaces": 2016000,
      "interfaces_per_device": 144,
      "interval_s": 300,
      "window_s": 25200,
      "samples_per_device_per_cycle": 1738
    }
  },
  "run": {
    "id": "pm-snmp-14k-cleanroom-1",
    "started_at": "2026-09-02T22:00:00Z",
    "ended_at": "2026-09-03T05:00:00Z",
    "trial": 1
  },
  "comparability_key": [
    "sut.version_identity",
    "sut.jvm.heap",
    "sut.jvm.gc",
    "sut.db_version",
    "sut.tss_backend",
    "host.cpu",
    "host.ram_gb",
    "host.generator_colocated",
    "workload.axis",
    "workload.generator_scenario",
    "workload.generator_version",
    "workload.parameters"
  ],
  "measurements": {
    "tsdb": {
      "kind": "prometheus",
      "url": "http://192.168.10.40:9090/prometheus",
      "version": "3.14.0"
    },
    "window": {
      "start": "2026-09-02T22:00:00Z",
      "end": "2026-09-03T05:00:00Z"
    },
    "resolution": "1m",
    "timezone": "Europe/Berlin",
    "annotations": {
      "tags": [
        "pm-snmp",
        "14000-devices",
        "kfk-exclusive",
        "cleanroom",
        "steady-state",
        "7h"
      ]
    },
    "figures": [
      {
        "id": "throughput",
        "title": "Collections completed per second against the rate the fleet requires",
        "unit": "collections/s",
        "kind": "line",
        "source": {
          "dashboard": "Prometheus: OpenNMS Core Internals",
          "panel": "Collectd tasks completed"
        },
        "note": "Required is the daemon's own collectable service count divided by the 300 s interval. A window integral of the counter is the honest rate; the rolling median is shown for shape only.",
        "series": [
          {
            "label": "achieved, 5-minute rate",
            "expr": "rate(opennms_collectd_taskscompleted{instance=\"core-benchmark-01:9299\"}[5m])",
            "decimals": 2
          },
          {
            "label": "required by the fleet",
            "expr": "opennms_collectd_collectableservicecount{instance=\"core-benchmark-01:9299\"} / 300",
            "decimals": 2
          }
        ]
      },
      {
        "id": "queue",
        "title": "Collectd pending queue, rolling one-minute peak and floor",
        "unit": "tasks",
        "kind": "peak-line",
        "source": {
          "dashboard": "Prometheus: OpenNMS Core Internals",
          "panel": "Collectd task queue"
        },
        "note": "The floor is the test. Seven hours with the floor returning to zero every cycle is a system that completes its work.",
        "series": [
          {
            "label": "rolling 1-minute peak",
            "expr": "max_over_time(opennms_collectd_taskqueuependingcount{instance=\"core-benchmark-01:9299\"}[1m])",
            "decimals": 0
          },
          {
            "label": "rolling 1-minute floor",
            "expr": "min_over_time(opennms_collectd_taskqueuependingcount{instance=\"core-benchmark-01:9299\"}[1m])",
            "decimals": 0
          }
        ]
      },
      {
        "id": "threads",
        "title": "Collectd thread pool occupancy against its 100-thread ceiling",
        "unit": "threads",
        "kind": "peak-line",
        "source": {
          "dashboard": "Prometheus: OpenNMS Core Internals",
          "panel": "Collectd threads"
        },
        "series": [
          {
            "label": "rolling 1-minute peak",
            "expr": "max_over_time(opennms_collectd_activethreads{instance=\"core-benchmark-01:9299\"}[1m])",
            "decimals": 0
          },
          {
            "label": "rolling 1-minute mean",
            "expr": "avg_over_time(opennms_collectd_activethreads{instance=\"core-benchmark-01:9299\"}[1m])",
            "decimals": 1
          },
          {
            "label": "pool ceiling",
            "expr": "opennms_collectd_maxpoolthreads{instance=\"core-benchmark-01:9299\"}",
            "decimals": 0
          }
        ]
      },
      {
        "id": "cpu-core-minion-db",
        "title": "CPU busy: Core, Minion and database",
        "unit": "% of all vCPU",
        "kind": "line",
        "source": {
          "dashboard": "Node Exporter Full",
          "panel": "CPU Basic"
        },
        "series": [
          {
            "label": "core (8 vCPU)",
            "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"core-benchmark-01:9100\",mode=\"idle\"}[5m])) * 100",
            "decimals": 1
          },
          {
            "label": "minion (4 vCPU)",
            "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"minion-benchmark-01:9100\",mode=\"idle\"}[5m])) * 100",
            "decimals": 1
          },
          {
            "label": "db (8 vCPU)",
            "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"db-benchmark-01:9100\",mode=\"idle\"}[5m])) * 100",
            "decimals": 1
          }
        ]
      },
      {
        "id": "cpu-kafka-netsim",
        "title": "CPU busy: Kafka broker and network simulator",
        "unit": "% of all vCPU",
        "kind": "line",
        "source": {
          "dashboard": "Node Exporter Full",
          "panel": "CPU Basic"
        },
        "series": [
          {
            "label": "kafka (2 vCPU)",
            "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"kafka-benchmark-01:9100\",mode=\"idle\"}[5m])) * 100",
            "decimals": 1
          },
          {
            "label": "netsim (4 vCPU)",
            "expr": "100 - avg(rate(node_cpu_seconds_total{instance=\"netsim-benchmark-01:9100\",mode=\"idle\"}[5m])) * 100",
            "decimals": 1
          }
        ]
      },
      {
        "id": "load",
        "title": "One-minute load per vCPU, every collection VM",
        "unit": "load / vCPU",
        "kind": "line",
        "source": {
          "dashboard": "Node Exporter Full",
          "panel": "System Load"
        },
        "note": "Normalised by vCPU count so a 2-vCPU broker and an 8-vCPU Core read on one scale. Above 1.0 means runnable work is queuing.",
        "series": [
          {
            "label": "core",
            "expr": "node_load1{instance=\"core-benchmark-01:9100\"} / 8",
            "decimals": 2
          },
          {
            "label": "minion",
            "expr": "node_load1{instance=\"minion-benchmark-01:9100\"} / 4",
            "decimals": 2
          },
          {
            "label": "database",
            "expr": "node_load1{instance=\"db-benchmark-01:9100\"} / 8",
            "decimals": 2
          },
          {
            "label": "kafka",
            "expr": "node_load1{instance=\"kafka-benchmark-01:9100\"} / 2",
            "decimals": 2
          },
          {
            "label": "netsim",
            "expr": "node_load1{instance=\"netsim-benchmark-01:9100\"} / 4",
            "decimals": 2
          }
        ]
      },
      {
        "id": "memory",
        "title": "Memory in use per VM",
        "unit": "% of RAM",
        "kind": "line",
        "source": {
          "dashboard": "Node Exporter Full",
          "panel": "Memory Basic"
        },
        "series": [
          {
            "label": "core",
            "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"core-benchmark-01:9100\"} / node_memory_MemTotal_bytes{instance=\"core-benchmark-01:9100\"})",
            "decimals": 1
          },
          {
            "label": "minion",
            "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"minion-benchmark-01:9100\"} / node_memory_MemTotal_bytes{instance=\"minion-benchmark-01:9100\"})",
            "decimals": 1
          },
          {
            "label": "db",
            "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"db-benchmark-01:9100\"} / node_memory_MemTotal_bytes{instance=\"db-benchmark-01:9100\"})",
            "decimals": 1
          },
          {
            "label": "kafka",
            "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"kafka-benchmark-01:9100\"} / node_memory_MemTotal_bytes{instance=\"kafka-benchmark-01:9100\"})",
            "decimals": 1
          },
          {
            "label": "netsim",
            "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"netsim-benchmark-01:9100\"} / node_memory_MemTotal_bytes{instance=\"netsim-benchmark-01:9100\"})",
            "decimals": 1
          }
        ]
      },
      {
        "id": "heap-gc",
        "title": "Core JVM heap against its ceiling, and old-generation collections",
        "unit": "GiB and per minute",
        "kind": "line",
        "source": {
          "dashboard": "Prometheus: Java Virtual Machine",
          "panel": "Heap"
        },
        "note": "Heap percentage is not a pressure signal: G1 fills whatever ceiling it is given. Old-generation collections are.",
        "series": [
          {
            "label": "heap used",
            "expr": "java_lang_memory_heapmemoryusage_used{instance=\"core-benchmark-01:9299\"} / 1024 / 1024 / 1024",
            "decimals": 2
          },
          {
            "label": "heap ceiling",
            "expr": "java_lang_memory_heapmemoryusage_max{instance=\"core-benchmark-01:9299\"} / 1024 / 1024 / 1024",
            "decimals": 2
          },
          {
            "label": "old-gen collections per minute",
            "expr": "rate(java_lang_g1_old_generation_collectioncount{instance=\"core-benchmark-01:9299\"}[5m]) * 60",
            "decimals": 2
          }
